# scripts/local configure fills secret placeholders with random local values.
ESPO_ADMIN_USERNAME=admin
ESPO_ADMIN_PASSWORD=CHANGE_ME
DEV_USER_PASSWORD=CHANGE_ME
DB_NAME=nurivoyage
DB_USER=nurivoyage
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=nurivoyage-documents
SMTP_HOST=mailpit
SMTP_PORT=1025
APP_URL=http://localhost:8080
WS_URL=ws://localhost:8081
DEFAULT_CURRENCY=ZAR
APP_TIMEZONE=Africa/Johannesburg
BIND_ADDRESS=127.0.0.1
# Explicit local subnet avoids exhausted Docker Desktop default address pools.
DOCKER_SUBNET=10.231.0.0/24
