#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
case "${1:-help}" in
  configure)
    python3 scripts/nurivoyage/configure.py ;;
  start)
    "$0" configure
    docker compose up -d --build --wait --wait-timeout 300
    python3 scripts/nurivoyage/publish-branding.py
    docker compose exec -T -u www-data crm php /opt/nurivoyage/bootstrap.php
    docker compose exec -T -u www-data crm php rebuild.php
    docker compose restart daemon websocket
    docker compose up -d --wait --wait-timeout 300
    "$0" credentials
    "$0" health-check ;;
  stop) docker compose down ;;
  bootstrap)
    python3 scripts/nurivoyage/publish-branding.py
    docker compose exec -T -u www-data crm php /opt/nurivoyage/bootstrap.php
    docker compose exec -T -u www-data crm php rebuild.php ;;
  reset-passwords)
    python3 scripts/nurivoyage/publish-branding.py
    docker compose exec -T -u www-data crm php /opt/nurivoyage/bootstrap.php --reset-passwords ;;
  credentials) python3 scripts/nurivoyage/credentials.py ;;
  health-check) python3 scripts/nurivoyage/health.py ;;
  smoke) python3 tests/nurivoyage/smoke.py ;;
  smoke-stage3) python3 tests/nurivoyage/stage3.py ;;
  smoke-stage4) python3 tests/nurivoyage/stage4.py ;;
  smoke-stage5) python3 tests/nurivoyage/stage5.py ;;
  smoke-stage6) python3 tests/nurivoyage/stage6.py ;;
  smoke-stage7) python3 tests/nurivoyage/stage7.py ;;
  smoke-stage8) python3 tests/nurivoyage/stage8.py ;;
  smoke-stage9) python3 tests/nurivoyage/stage9.py ;;
  seed-stage7-demo) python3 scripts/nurivoyage/seed-stage7-demo.py ;;
  import-catalogue) python3 scripts/nurivoyage/import-catalogue.py "$2" ;;
  backup) bash scripts/nurivoyage/backup.sh ;;
  restore) bash scripts/nurivoyage/restore.sh "${2:?Usage: scripts/local restore backups/TIMESTAMP}" ;;
  reset-local)
    echo 'WARNING: This deletes ALL NuriVoyage local Docker volumes. Backups and Git files remain.'
    read -r -p 'Type DELETE NURIVOYAGE to confirm: ' answer
    test "$answer" = 'DELETE NURIVOYAGE' || exit 1
    docker compose down -v
    "$0" start ;;
  *) echo 'Usage: scripts/local {configure|start|stop|bootstrap|reset-passwords|credentials|health-check|smoke|smoke-stage3|smoke-stage4|smoke-stage5|smoke-stage6|smoke-stage7|smoke-stage8|smoke-stage9|seed-stage7-demo|import-catalogue FILE.csv|backup|restore DIR|reset-local}' ;;
esac
