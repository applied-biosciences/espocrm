{
  "fields": {
    "name": {
      "type": "varchar",
      "required": true,
      "pattern": "$noBadCharacters"
    },
    "description": {
      "type": "text"
    },
    "createdAt": {
      "type": "datetime",
      "readOnly": true
    },
    "modifiedAt": {
      "type": "datetime",
      "readOnly": true
    },
    "createdBy": {
      "type": "link",
      "readOnly": true,
      "view": "views/fields/user"
    },
    "modifiedBy": {
      "type": "link",
      "readOnly": true,
      "view": "views/fields/user"
    },
    "assignedUser": {
      "type": "link",
      "required": false,
      "view": "views/fields/assigned-user"
    },
    "teams": {
      "type": "linkMultiple",
      "view": "views/fields/teams"
    },
    "destination": {
      "type": "varchar"
    },
    "sellingPrice": {
      "type": "currency",
      "min": 0
    },
    "durationDays": { "type": "int", "min": 1 },
    "productType": { "type": "enum", "options": ["Flight", "Hotel", "Transfer", "Visa", "Package", "Activity", "Other"], "default": "Package" },
    "supplier": { "type": "link" },
    "supplierProductCode": { "type": "varchar" },
    "supplierCost": { "type": "currency", "min": 0 },
    "validFrom": { "type": "date" },
    "validTo": { "type": "date" },
    "active": { "type": "bool", "default": true }
  },
  "links": {
    "createdBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "modifiedBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "assignedUser": {
      "type": "belongsTo",
      "entity": "User"
    },
    "teams": {
      "type": "hasMany",
      "entity": "Team",
      "relationName": "entityTeam",
      "layoutRelationshipsDisabled": true
    },
    "supplier": {
      "type": "belongsTo",
      "entity": "NvSupplier"
    }
  },
  "collection": {
    "orderBy": "createdAt",
    "order": "desc"
  },
  "indexes": {
    "name": {
      "columns": [
        "name",
        "deleted"
      ]
    },
    "assignedUser": {
      "columns": [
        "assignedUserId",
        "deleted"
      ]
    },
    "createdAt": {
      "columns": [
        "createdAt"
      ]
    },
    "createdAtId": {
      "unique": true,
      "columns": [
        "createdAt",
        "id"
      ]
    }
  }
}
