{
  "fields": {
    "name": {
      "type": "varchar",
      "required": true,
      "pattern": "$noBadCharacters"
    },
    "description": {
      "type": "text"
    },
    "createdAt": {
      "type": "datetime",
      "readOnly": true
    },
    "modifiedAt": {
      "type": "datetime",
      "readOnly": true
    },
    "createdBy": {
      "type": "link",
      "readOnly": true,
      "view": "views/fields/user"
    },
    "modifiedBy": {
      "type": "link",
      "readOnly": true,
      "view": "views/fields/user"
    },
    "assignedUser": {
      "type": "link",
      "required": false,
      "view": "views/fields/assigned-user"
    },
    "teams": {
      "type": "linkMultiple",
      "view": "views/fields/teams"
    },
    "customer": { "type": "link" },
    "leadTraveller": { "type": "link" },
    "enquiry": {
      "type": "link"
    },
    "package": {
      "type": "link"
    },
    "status": {
      "type": "enum",
      "options": [
        "New Enquiry",
        "Qualified",
        "Quote Prepared",
        "Quote Sent",
        "Follow-up",
        "Customer Accepted",
        "Deposit Requested",
        "Deposit Paid",
        "Booking Confirmed",
        "Lost",
        "Cancelled",
        "Expired Quote"
      ],
      "default": "New Enquiry",
      "audited": true
    },
    "supplierStatus": {
      "type": "enum",
      "options": [
        "Booking Confirmed",
        "Supplier Selected",
        "Purchase Order Created",
        "PO Emailed",
        "Supplier Confirmation",
        "Supplier Invoice Received",
        "Payment Due",
        "Paid"
      ],
      "default": "Booking Confirmed",
      "audited": true
    },
    "sellingPrice": {
      "type": "currency",
      "min": 0
    },
    "travelDate": {
      "type": "date"
    },
    "returnDate": {
      "type": "date"
    },
    "bookingReference": {
      "type": "varchar",
      "audited": true
    },
    "itineraryTitle": {
      "type": "varchar"
    },
    "destination": {
      "type": "varchar"
    },
    "departureCity": {
      "type": "varchar"
    },
    "arrivalCity": {
      "type": "varchar"
    },
    "travellerCount": {
      "type": "int",
      "min": 1
    },
    "itineraryNotes": {
      "type": "text"
    },
    "itineraryCities": {
      "type": "text"
    },
    "confirmedAt": {
      "type": "datetime",
      "audited": true
    }
  },
  "links": {
    "createdBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "modifiedBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "assignedUser": {
      "type": "belongsTo",
      "entity": "User"
    },
    "teams": {
      "type": "hasMany",
      "entity": "Team",
      "relationName": "entityTeam",
      "layoutRelationshipsDisabled": true
    },
    "customer": {
      "type": "belongsTo",
      "entity": "Account"
    },
    "enquiry": {
      "type": "belongsTo",
      "entity": "NvEnquiry"
    },
    "package": {
      "type": "belongsTo",
      "entity": "NvPackage"
    },
    "leadTraveller": {
      "type": "belongsTo",
      "entity": "NvTraveller"
    },
    "travellers": {
      "type": "hasMany",
      "entity": "NvTraveller",
      "foreign": "booking"
    },
    "itinerarySegments": {
      "type": "hasMany",
      "entity": "NvItinerarySegment",
      "foreign": "booking"
    },
    "transfers": {
      "type": "hasMany",
      "entity": "NvTransfer",
      "foreign": "booking"
    },
    "sightseeing": {
      "type": "hasMany",
      "entity": "NvSightseeing",
      "foreign": "booking"
    }
  },
  "collection": {
    "orderBy": "createdAt",
    "order": "desc"
  },
  "indexes": {
    "name": {
      "columns": [
        "name",
        "deleted"
      ]
    },
    "assignedUser": {
      "columns": [
        "assignedUserId",
        "deleted"
      ]
    },
    "createdAt": {
      "columns": [
        "createdAt"
      ]
    },
    "createdAtId": {
      "unique": true,
      "columns": [
        "createdAt",
        "id"
      ]
    }
  }
}
