{
  "fields": {
    "name": {
      "type": "varchar",
      "required": true,
      "pattern": "$noBadCharacters"
    },
    "description": {
      "type": "text"
    },
    "createdAt": {
      "type": "datetime",
      "readOnly": true
    },
    "modifiedAt": {
      "type": "datetime",
      "readOnly": true
    },
    "createdBy": {
      "type": "link",
      "readOnly": true,
      "view": "views/fields/user"
    },
    "modifiedBy": {
      "type": "link",
      "readOnly": true,
      "view": "views/fields/user"
    },
    "assignedUser": {
      "type": "link",
      "required": false,
      "view": "views/fields/assigned-user"
    },
    "teams": {
      "type": "linkMultiple",
      "view": "views/fields/teams"
    },
    "booking": {
      "type": "link"
    },
    "traveller": {
      "type": "link"
    },
    "file": {
      "type": "file"
    },
    "documentType": {
      "type": "enum",
      "options": [
        "Synthetic Itinerary",
        "Synthetic Passport",
        "Voucher",
        "Other"
      ],
      "default": "Synthetic Itinerary",
      "audited": true
    },
    "expiryDate": {
      "type": "date"
    },
    "documentNumber": {
      "type": "varchar",
      "audited": true
    },
    "countryOfIssue": {
      "type": "varchar"
    },
    "issueDate": {
      "type": "date"
    },
    "verificationStatus": {
      "type": "enum",
      "options": [
        "Pending",
        "Verified",
        "Rejected",
        "Expired"
      ],
      "default": "Pending",
      "audited": true
    },
    "verifiedAt": {
      "type": "datetime",
      "readOnly": true
    },
    "verifiedBy": {
      "type": "link",
      "readOnly": true,
      "view": "views/fields/user"
    },
    "verificationHistory": {
      "type": "text",
      "audited": true
    },
    "retentionRule": {
      "type": "enum",
      "options": [
        "Keep until expiry",
        "Keep 7 years",
        "Keep indefinitely"
      ],
      "default": "Keep until expiry",
      "audited": true
    },
    "retentionUntil": {
      "type": "date"
    },
    "expiryAlertDays": {
      "type": "int",
      "min": 0,
      "default": 30
    },
    "checklistStatus": {
      "type": "enum",
      "options": [
        "Not Started",
        "In Progress",
        "Complete",
        "Exception"
      ],
      "default": "Not Started",
      "audited": true
    },
    "pdfReady": {
      "type": "bool",
      "default": false
    },
    "printable": {
      "type": "bool",
      "default": true
    }
  },
  "links": {
    "createdBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "modifiedBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "assignedUser": {
      "type": "belongsTo",
      "entity": "User"
    },
    "teams": {
      "type": "hasMany",
      "entity": "Team",
      "relationName": "entityTeam",
      "layoutRelationshipsDisabled": true
    },
    "booking": {
      "type": "belongsTo",
      "entity": "NvBooking"
    },
    "traveller": {
      "type": "belongsTo",
      "entity": "NvTraveller"
    },
    "verifiedBy": {
      "type": "belongsTo",
      "entity": "User"
    }
  },
  "collection": {
    "orderBy": "createdAt",
    "order": "desc"
  },
  "indexes": {
    "name": {
      "columns": [
        "name",
        "deleted"
      ]
    },
    "assignedUser": {
      "columns": [
        "assignedUserId",
        "deleted"
      ]
    },
    "createdAt": {
      "columns": [
        "createdAt"
      ]
    },
    "createdAtId": {
      "unique": true,
      "columns": [
        "createdAt",
        "id"
      ]
    }
  }
}
