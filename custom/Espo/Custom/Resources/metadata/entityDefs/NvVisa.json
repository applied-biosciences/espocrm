{
  "fields": {
    "name": {
      "type": "varchar",
      "required": true,
      "pattern": "$noBadCharacters"
    },
    "description": {
      "type": "text"
    },
    "createdAt": {
      "type": "datetime",
      "readOnly": true
    },
    "modifiedAt": {
      "type": "datetime",
      "readOnly": true
    },
    "createdBy": {
      "type": "link",
      "readOnly": true,
      "view": "views/fields/user"
    },
    "modifiedBy": {
      "type": "link",
      "readOnly": true,
      "view": "views/fields/user"
    },
    "assignedUser": {
      "type": "link",
      "required": false,
      "view": "views/fields/assigned-user"
    },
    "teams": {
      "type": "linkMultiple",
      "view": "views/fields/teams"
    },
    "booking": {
      "type": "link"
    },
    "supplier": {
      "type": "link"
    },
    "traveller": {
      "type": "link"
    },
    "bookingItem": {
      "type": "link"
    },
    "status": {
      "type": "enum",
      "options": [
        "Required",
        "Submitted",
        "Approved",
        "Rejected"
      ],
      "default": "Required",
      "audited": true
    },
    "country": {
      "type": "varchar"
    }
  },
  "links": {
    "createdBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "modifiedBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "assignedUser": {
      "type": "belongsTo",
      "entity": "User"
    },
    "teams": {
      "type": "hasMany",
      "entity": "Team",
      "relationName": "entityTeam",
      "layoutRelationshipsDisabled": true
    },
    "booking": {
      "type": "belongsTo",
      "entity": "NvBooking"
    },
    "supplier": {
      "type": "belongsTo",
      "entity": "NvSupplier"
    },
    "traveller": {
      "type": "belongsTo",
      "entity": "NvTraveller"
    },
    "bookingItem": {
      "type": "belongsTo",
      "entity": "NvBookingItem"
    }
  },
  "collection": {
    "orderBy": "createdAt",
    "order": "desc"
  },
  "indexes": {
    "name": {
      "columns": [
        "name",
        "deleted"
      ]
    },
    "assignedUser": {
      "columns": [
        "assignedUserId",
        "deleted"
      ]
    },
    "createdAt": {
      "columns": [
        "createdAt"
      ]
    },
    "createdAtId": {
      "unique": true,
      "columns": [
        "createdAt",
        "id"
      ]
    }
  }
}
