{
  "fields": {
    "name": {
      "type": "varchar",
      "required": true,
      "pattern": "$noBadCharacters"
    },
    "description": {
      "type": "text"
    },
    "createdAt": {
      "type": "datetime",
      "readOnly": true
    },
    "modifiedAt": {
      "type": "datetime",
      "readOnly": true
    },
    "createdBy": {
      "type": "link",
      "readOnly": true,
      "view": "views/fields/user"
    },
    "modifiedBy": {
      "type": "link",
      "readOnly": true,
      "view": "views/fields/user"
    },
    "assignedUser": {
      "type": "link",
      "required": false,
      "view": "views/fields/assigned-user"
    },
    "teams": {
      "type": "linkMultiple",
      "view": "views/fields/teams"
    },
    "customer": {
      "type": "link"
    },
    "booking": {
      "type": "link"
    },
    "dateOfBirth": {
      "type": "date"
    },
    "nationality": {
      "type": "varchar"
    },
    "passportNumber": { "type": "varchar", "audited": true },
    "passportCountry": { "type": "varchar" },
    "passportIssueDate": { "type": "date" },
    "passportExpiryDate": { "type": "date", "audited": true }
    ,"passportPhoto": {
      "type": "file",
      "audited": true
    }
  },
  "links": {
    "createdBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "modifiedBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "assignedUser": {
      "type": "belongsTo",
      "entity": "User"
    },
    "teams": {
      "type": "hasMany",
      "entity": "Team",
      "relationName": "entityTeam",
      "layoutRelationshipsDisabled": true
    },
    "customer": {
      "type": "belongsTo",
      "entity": "Account"
    },
    "booking": {
      "type": "belongsTo",
      "entity": "NvBooking"
    }
  },
  "collection": {
    "orderBy": "createdAt",
    "order": "desc"
  },
  "indexes": {
    "name": {
      "columns": [
        "name",
        "deleted"
      ]
    },
    "assignedUser": {
      "columns": [
        "assignedUserId",
        "deleted"
      ]
    },
    "createdAt": {
      "columns": [
        "createdAt"
      ]
    },
    "createdAtId": {
      "unique": true,
      "columns": [
        "createdAt",
        "id"
      ]
    }
  }
}
