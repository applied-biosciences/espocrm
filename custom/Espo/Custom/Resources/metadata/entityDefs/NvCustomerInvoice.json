{
  "fields": {
    "name": {
      "type": "varchar",
      "required": true,
      "pattern": "$noBadCharacters"
    },
    "invoiceNumber": { "type": "autoincrement", "index": true },
    "description": {
      "type": "text"
    },
    "createdAt": {
      "type": "datetime",
      "readOnly": true
    },
    "modifiedAt": {
      "type": "datetime",
      "readOnly": true
    },
    "createdBy": {
      "type": "link",
      "readOnly": true,
      "view": "views/fields/user"
    },
    "modifiedBy": {
      "type": "link",
      "readOnly": true,
      "view": "views/fields/user"
    },
    "assignedUser": {
      "type": "link",
      "required": false,
      "view": "views/fields/assigned-user"
    },
    "teams": {
      "type": "linkMultiple",
      "view": "views/fields/teams"
    },
    "booking": {
      "type": "link"
    },
    "customer": {
      "type": "link"
    },
    "status": {
      "type": "enum",
      "options": [
        "Draft",
        "Issued",
        "Part Paid",
        "Paid",
        "Cancelled"
      ],
      "default": "Draft",
      "audited": true
    },
    "amount": {
      "type": "currency",
      "min": 0
    },
    "paidAmount": { "type": "currency", "min": 0, "default": 0 },
    "balanceAmount": { "type": "currency", "min": 0, "readOnly": true },
    "dueDate": {
      "type": "date"
    }
  },
  "links": {
    "createdBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "modifiedBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "assignedUser": {
      "type": "belongsTo",
      "entity": "User"
    },
    "teams": {
      "type": "hasMany",
      "entity": "Team",
      "relationName": "entityTeam",
      "layoutRelationshipsDisabled": true
    },
    "booking": {
      "type": "belongsTo",
      "entity": "NvBooking"
    },
    "customer": {
      "type": "belongsTo",
      "entity": "Account"
    }
  },
  "collection": {
    "orderBy": "createdAt",
    "order": "desc"
  },
  "indexes": {
    "name": {
      "columns": [
        "name",
        "deleted"
      ]
    },
    "assignedUser": {
      "columns": [
        "assignedUserId",
        "deleted"
      ]
    },
    "createdAt": {
      "columns": [
        "createdAt"
      ]
    },
    "createdAtId": {
      "unique": true,
      "columns": [
        "createdAt",
        "id"
      ]
    }
  }
}
